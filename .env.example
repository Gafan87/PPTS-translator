# Flask слушает только локальный компьютер по умолчанию.
APP_HOST=127.0.0.1
APP_PORT=5001
FLASK_DEBUG=false

# Можно задать ключ здесь или в интерфейсе настроек.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Не отключайте проверку сертификата без крайней необходимости.
DEEPSEEK_VERIFY_TLS=true

# Максимальный объём исходного текста в одном запросе.
PROMPT_BATCH_CHARS=24000
MAX_UPLOAD_MB=200

# Разрешённые origins для API; несколько значений через запятую.
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001
